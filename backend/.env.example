# Backend environment configuration
# Copy this file to .env and fill in your values for local development or production.
# Never commit .env files — they contain secrets.

NODE_ENV=production              # "development" | "production"
PORT=                            # Server port (e.g. 5000)
TRUST_PROXY=false                # Set true only behind one trusted proxy/load balancer
MONGO_URI=                       # MongoDB connection string (e.g. mongodb+srv://...)
JWT_SECRET=                      # Strong random secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_REFRESH_COOKIE_SAME_SITE=lax # Refresh-cookie SameSite policy; defaults to lax. Do not loosen cookie protections without deployment review.
CLIENT_URL=                      # Frontend origin(s) for CORS, comma-separated (e.g. https://app.example.com)
APP_PUBLIC_URL=                  # Public URL of this backend (e.g. https://api.example.com)
GOOGLE_CLIENT_ID=                # Google OAuth web client ID for ID token verification

# Shared Redis — required in production for rate limits and cross-instance Socket.IO rooms/events.
# Use a private ACL-protected Redis endpoint; prefer rediss:// when TLS is available. Never log or commit this URL.
REDIS_URL=                       # e.g. rediss://username:password@redis.internal:6380/0
REDIS_NAMESPACE=hairbook         # Optional safe key/channel prefix; use a distinct value per environment

# Rate limiting — enabled by default outside NODE_ENV=test; production uses the shared Redis store above.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=120
RATE_LIMIT_UPLOAD_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=40
RATE_LIMIT_PAYMENT_WINDOW_MS=900000
RATE_LIMIT_PAYMENT_MAX=60

# Payments — provider-ready, no real provider integrated yet
PAYMENT_PROVIDER=manual           # "manual" | "disabled" | "mock" | "test"; mock/test disabled in production
PAYMENT_WEBHOOK_SECRET=           # Optional provider webhook secret
PAYMENT_SUCCESS_URL=              # Optional checkout success redirect URL
PAYMENT_CANCEL_URL=               # Optional checkout cancel redirect URL

# Email — optional; leave blank if not used
EMAIL_HOST=                      # SMTP host, e.g. smtp.example.com
EMAIL_PORT=                      # SMTP port, e.g. 587
EMAIL_SECURE=false               # true for implicit TLS/465, false for STARTTLS/587
EMAIL_USER=                      # SMTP username
EMAIL_PASS=                      # SMTP password
EMAIL_FROM=                      # Sender address, e.g. "HairBook <noreply@example.com>"
EMAIL_PROVIDER=                  # Legacy verification provider: "resend" or leave empty
RESEND_API_KEY=                  # Legacy Resend API key
EMAIL_REPLY_TO=                  # Legacy verification reply-to address (optional)

# Scheduler / cron jobs — opt-in unless noted below
ENABLE_BOOKING_REMINDERS=false               # Smart booking reminder scheduler
BOOKING_REMINDER_INTERVAL_MS=60000
BOOKING_REMINDER_STALE_CLAIM_TIMEOUT_MS=300000 # Advanced: stale-claim recovery timing for multi-instance/failure recovery
ENABLE_WAITLIST_EXPIRATION=false             # Past-date waitlist expiration
WAITLIST_EXPIRATION_INTERVAL_MS=3600000
ENABLE_SUBSCRIPTION_EXPIRATION_CRON=false    # Periodically expire ended subscriptions
SUBSCRIPTION_EXPIRATION_INTERVAL_MS=86400000
ENABLE_CLEANUP_NON_WORKING_DAYS_CRON=false   # Nightly cleanup of past non-working days
# Pending booking expiration is enabled when unset; set ENABLE_EXPIRE_PENDING_BOOKINGS_CRON=false only to disable.
ENABLE_EVENT_REMINDERS_CRON=false            # Send reminders for upcoming events
EVENT_REMINDER_STALE_CLAIM_TIMEOUT_MS=300000 # Advanced: stale-claim recovery timing for multi-instance/failure recovery

# Platform superuser bootstrap/recovery — optional; not a staff permission system.
# Comma-separated allowlist of verified user emails and/or IDs for /api/platform/*.
# A match resolves to the same platform superuser principal as DB platformRole="superuser".
# Platform routes use explicit known capabilities; do not add role-specific env allowlists.
PLATFORM_ADMIN_EMAILS=                       # e.g., platform-operator@example.com
PLATFORM_ADMIN_IDS=                          # e.g., 64abc...,64def...

# Debug / logging
EMAIL_VERIFICATION_LOG_URL=false             # Log verification links instead of sending email (disable in production)

# Structured logging (Pino)
LOG_LEVEL=info                               # One of: trace, debug, info, warn, error, fatal
LOG_PRETTY=false                             # Set true for human-readable output (dev only)
SERVICE_NAME=hairbook-backend                # Service identifier for structured logs
RELEASE=                                     # Git SHA or release tag for log metadata (optional)

SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
